# Copy to .env and fill in. Real environment variables override this file.

# Public URL of the app (used for the Google redirect). Leave empty for local use.
TEKPLANE_BASE_URL=http://localhost:8000

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → "Web application"
# Authorized redirect URI: <TEKPLANE_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (one-time login codes & invitations) ---------------------------
# Without SMTP_HOST the codes are printed in the server terminal (development mode).
# Gmail example: smtp.gmail.com / 587 / starttls, with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tek-plane <no-reply@example.com>
