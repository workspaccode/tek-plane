# Copy to .env and fill in, then restart the server (./run.sh).
# Real environment variables override this file.

# Public URL of the app, used in email links and for the Google redirect.
# Leave it empty to use whatever address people open (localhost, or your Wi-Fi IP with ./run.sh --lan).
# Set it only for a real domain, e.g. https://plane.example.com
TEKPLANE_BASE_URL=

# Site admins (comma-separated emails). They see "Admin" in the sidebar: users, projects,
# activity and system health. Sign in with one of these emails to get access.
TEKPLANE_ADMIN_EMAILS=

# =====================================================================
# Email (login codes, activation links, invitations)
# Pick ONE option. Then test it:  uv run python -m backend.app.mailer you@example.com
# Without either, emails are printed in the server terminal (development mode).
# =====================================================================

# --- Option A: Resend (simplest: one API key) -------------------------
# 1. Sign up at https://resend.com → API Keys → Create API key
# 2. To send to any address, verify your domain under Domains.
#    Without a domain you can only send to your own Resend account email,
#    using EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=tek-plane <onboarding@resend.dev>

# --- Option B: SMTP (e.g. Gmail) -------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (16 letters) below.
# Your normal Gmail password will NOT work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "tek-plane <you@gmail.com>". Defaults to SMTP_USER.
SMTP_FROM=

# =====================================================================
# Google sign-in (name, photo and email come from the Google account)
# 1. https://console.cloud.google.com → create a project
# 2. APIs & Services → OAuth consent screen → External → fill app name + your email
# 3. Credentials → Create credentials → OAuth client ID → "Web application"
#    Authorized redirect URI:  http://localhost:8000/api/auth/google/callback
#    (use your real domain in production)
# 4. Paste the Client ID and Client secret here.
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
